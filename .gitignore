# IDE folders
.idea/
.vs/
.vscode/
.zed/
.claude/

# Caches
__pycache__
.mypy_cache
.cache/

# Original files
orig/*/*
!orig/*/.gitkeep
*.dol
*.rel
*.elf
*.o
*.map
*.MAP

# Build files
build/
build-*/
.ninja_*
build.ninja

# DolRecomp output (tools/port/recompile.py) - derives from a copyrighted
# disc image, never committed. See docs/recompilation.md.
/generated/

# decompctx output
ctx.*
*.ctx

# Generated configs
objdiff.json
compile_commands.json

# Miscellaneous
/*.txt
!/CMakeLists.txt
*.exe
tools/mwcc_compiler

# Local scratch scripts, dumps and logs at the repository root
/scratch_*
/*.s
/*.log
/*.json
/*.ps1
/*.py
!/configure.py

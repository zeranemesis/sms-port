+extern "C" void GXPC_BeginDataPass(unsigned short, unsigned short) __attribute__((weak));
+#endif
+
 static void drawBlack(u16 param_1, u16 param_2)
 {
 
@@ -337,5 +341,9 @@
 	const TPollutionLayer* layer = mLayers[layer_index];

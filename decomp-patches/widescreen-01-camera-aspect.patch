Reason: port: SMS_WIDESCREEN widens the game camera's aspect by the displayed width over 4:3, so the view, frustum culling, particles and screen-projected textures all see the wider frame that sms_gx renders
--- a/src/System/MarDirectorSetupObjects.cpp
+++ b/src/System/MarDirectorSetupObjects.cpp
@@ -38,6 +38,12 @@
 #include <sms_modhook.h>
 #endif
 
+#ifdef TARGET_PC
+// SMS_WIDESCREEN (platform): the displayed width over the GameCube's 4:3, 1
+// when off. The camera sees that much wider, and sms_gx widens the frame.
+extern "C" float port_widescreen;
+#endif
+
 extern void* gpSceneCmnDat;
 extern int gpSceneCmnDatSize;
 
@@ -374,5 +374,8 @@
 // The retail code divides by the render height, not the video height.
 		cam->mAspect = (u16)SMSGetGameVideoWidth() * 0.91346145f
 		               / (u16)SMSGetGameRenderHeight();
+#ifdef TARGET_PC
+		cam->mAspect *= port_widescreen;
+#endif
 	}
 

Reason: port: thread entry points return their callee's result, as retail leaves it in r3; direct() reads it, so a failed setup moves on (Cutscene Removal's movies, which the THP player refuses, are skipped instead of waiting forever)
--- a/src/GC2D/SelectDir.cpp
+++ b/src/GC2D/SelectDir.cpp
@@ -82,9 +82,13 @@
 
 void* TSelectDir::setupThreadFunc(void* param_1)
 {
-	((TSelectDir*)param_1)->rsetup();
 #ifdef TARGET_PC
-	return nullptr; // thread exit value: retail leaves the callee's r3, nothing reads it
+	// The thread's exit value is the callee's result, which retail leaves in
+	// r3. direct() reads it through OSJoinThread, so a setup that fails moves
+	// on (a movie that will not open, such as Cutscene Removal's, is skipped).
+	return (void*)(intptr_t)((TSelectDir*)param_1)->rsetup();
+#else
+	((TSelectDir*)param_1)->rsetup();
 #endif
 }
 

 			for (s16 sr = 0; sr < 4; ++sr) {
 				for (s16 sc = 0; sc < 4; ++sc) {
+#ifdef TARGET_PC
+					s32 v = ((port_be16(block + sr + sc * 4) & 0xFFu) << 16)
+					        | port_be16(block + sr + sc * 4 + 0x10);
+#else
 					s32 v = (((block + sr + sc * 4)[0] << 16) & 0xFF0000)
 					        | (block + sr + sc * 4)[0x10];
+#endif
 					unk20[sr + br * 4][sc + bc * 4].y
 					    = h * ((f32)v * (1.0f / 16777216.0f));

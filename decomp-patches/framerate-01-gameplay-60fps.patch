Reason: port: frame_rate = 60 (SMS_FRAME_RATE) runs gameplay at 60 frames per second: one retrace per frame instead of two while TMarDirector runs, and SMSGetVSyncTimesPerSec reports 60 so the game's own timing (animation rates, fades, menus) stays in real time; the root fader takes the rate in force
--- a/src/System/Application.cpp
+++ b/src/System/Application.cpp
@@ -81,6 +81,28 @@
 
 extern "C" void ReInitializeGX();
 
+#ifdef TARGET_PC
+// Port: frame_rate = 60 runs gameplay at one retrace per frame instead of
+// two. The game times its animations, fades and menus by
+// SMSGetVSyncTimesPerSec, so doubling what it returns keeps them in real
+// time; the pieces that count frames instead are adjusted where they are.
+// Other directors (logos, menus, movies) stay at 30.
+extern "C" int port_frame_rate;
+extern "C" int port_gameplay_director_active;
+int port_gameplay_director_active;
+extern "C" int port_fps60_active;
+int port_fps60_active;
+f32 SMSGetVSyncTimesPerSec();
+static void portSetGameplayFrameRate(TApplication* app, bool gameplay)
+{
+	port_gameplay_director_active = gameplay;
+	port_fps60_active   = gameplay && port_frame_rate == 60;
+	app->mDisplay->unk4C = port_fps60_active ? 1 : 2;
+	// the root fader outlives directors; it was made with the boot-time rate
+	app->mFader->mRate = SMSGetVSyncTimesPerSec();
+}
+#endif
+
 #ifdef VERSION_GMSP01
 f32 SMSGetRealVSyncTimesPerSec()
 {
@@ -102,6 +124,10 @@

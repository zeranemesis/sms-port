+#ifdef TARGET_PC
+	if (port_fps60_active)
+		return SMSGetRealVSyncTimesPerSec();
+#endif
 	return SMSGetRealVSyncTimesPerSec() / 2.0f;
 #else
 	f32 result = 60.0f;

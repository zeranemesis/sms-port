 			       && d->mEntries[mDataCounter].mStartFrame
 			              <= mCurrentTime + speed) {
-				playActorAnimSound(interface, actor, speed, param3);
+				playActorAnimSound(interface, actor, JAIAnimePortSpeed(speed), param3);
 			}

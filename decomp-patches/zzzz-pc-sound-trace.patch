Reason: port diagnostics: SMS_SOUND_TRACE=1 logs every JAIBasic::startSoundActor request with its caller, and every animation-sound loop wrap
--- a/libs/JSystem/src/JAudio/JAInterface/JAIBasic.cpp
+++ b/libs/JSystem/src/JAudio/JAInterface/JAIBasic.cpp
@@ -707,6 +707,22 @@
 void JAIBasic::startSoundActor(u32 id, JAISoundHandle* out_handle,
                                JAIActor* actor, u32 fade, u8 camera_idx)
 {
+#ifdef TARGET_PC
+	// SMS_SOUND_TRACE=1: every sound request, with the code that made it, to
+	// find sounds a frame-counting caller starts too often at 60 fps.
+	static int trace = -1;
+	if (trace < 0) {
+		const char* e = getenv("SMS_SOUND_TRACE");
+		trace         = e && e[0] == '1';
+		// Unbuffered stderr makes every line a separate file write: buffer it.
+		if (trace)
+			setvbuf(stderr, nullptr, _IOFBF, 1 << 16);
+	}
+	// The CPU counter, not OSGetTick: that one runs pending interrupts.
+	if (trace)
+		fprintf(stderr, "[sound] t=%u id=0x%08x handle=%s from %p\n", (unsigned)(__builtin_ia32_rdtsc() >> 20),
+		        (unsigned)id, out_handle && *out_handle ? "busy" : "free", __builtin_return_address(0));
+#endif
 	u32 format = getInfoFormat(getInfoPointerFromID(id), id);
 	if (format & 1)
 		startSoundIndirectID(id, out_handle, actor, fade, camera_idx);

+#ifdef TARGET_PC
+#include <dolphin/os.h>
+
+// port: see J3DModel.hpp. Writes land in an object no model draws; reads see
+// a default-constructed node, as Dolphin's unmapped reads see zero.
+enum { PORT_J3D_JOINT, PORT_J3D_SHAPE, PORT_J3D_MATERIAL, PORT_J3D_MATRIX };
+
+static void port_j3d_report_missing(int kind, u16 index, u16 count)
+{
+	static const char* const names[] = { "joint", "shape", "material", "matrix" };
+	static u32 reported[4][8];
+	if (index < 256 && (reported[kind][index >> 5] & (1u << (index & 31))))
+		return;
+	if (index < 256)
+		reported[kind][index >> 5] |= 1u << (index & 31);
+	OSReport("[j3d] a model has no %s %u (it has %u); using a stand-in, as a mod built for "
+	         "Dolphin without MMU expects\n",
+	         names[kind], index, count);
+}
+
+J3DJoint* port_j3d_missing_joint(u16 index, u16 count)
+{
+	static J3DJoint standIn;
+	port_j3d_report_missing(PORT_J3D_JOINT, index, count);
+	return &standIn;
+}
+
+J3DShape* port_j3d_missing_shape(u16 index, u16 count)
+{
+	static J3DShape standIn;
+	port_j3d_report_missing(PORT_J3D_SHAPE, index, count);
+	return &standIn;
+}
+J3DMaterial* port_j3d_missing_material(u16 index, u16 count)
+{
+	// Marked unique, so change() leaves it alone instead of reading the
+	// original material it does not have.
+	static J3DMaterial standIn;
+	standIn.setMaterialID(1u << 30);
+	port_j3d_report_missing(PORT_J3D_MATERIAL, index, count);
+	return &standIn;
+}
+
+MtxPtr port_j3d_missing_matrix(int index, u16 count)
+{
+	static Mtx standIn;
+	MTXIdentity(standIn);
+	port_j3d_report_missing(PORT_J3D_MATRIX, u16(index), count);
+	return standIn;
+}
+#endif

+// Opens a cache database, discarding it if SQLite reports it as corrupt. These
+// files only hold data that can be rebuilt, so a malformed one is moved aside
+// (as "<name>.corrupt") and replaced by an empty database instead of failing
+// every later query.
+inline int open_cache_db(const std::filesystem::path& path, sqlite3** db, Module& log) {
+  const auto pathString = path.u8string();
+  const std::string file{reinterpret_cast<const char*>(pathString.c_str()), pathString.size()};
+  for (int attempt = 0; attempt < 2; ++attempt) {
+    int ret = sqlite3_open(file.c_str(), db);
+    if (ret == SQLITE_OK) {
+      std::string result;
+      ret = exec(*db, "PRAGMA quick_check(1);", [&result](int argc, char** argv, char**) {
+        if (argc > 0 && argv[0] != nullptr) {
+          result = argv[0];
+        }
+      });
+      if (ret == SQLITE_OK && result == "ok") {
+        return SQLITE_OK;
+      }
+      if (ret == SQLITE_OK || is_corruption(ret)) {
+        log.warn("Cache database '{}' is corrupt ({}); rebuilding it",
+                 file, result.empty() ? sqlite3_errmsg(*db) : result);
+        ret = SQLITE_CORRUPT;
+      }
+    }
+    if (!is_corruption(ret) || attempt != 0) {
+      return ret;
+    }
+    sqlite3_close(*db);
+    *db = nullptr;
+    std::error_code ec;
+    auto aside = path;
+    aside += ".corrupt";
+    std::filesystem::rename(path, aside, ec);
+    if (ec) {
+      std::filesystem::remove(path, ec);
+    }
+    for (const char* suffix : {"-wal", "-shm"}) {
+      auto extra = path;
+      extra += suffix;
+      std::filesystem::remove(extra, ec);
+    }
+  }
+  return SQLITE_CORRUPT;
+}
+
 } // namespace aurora::sqlite

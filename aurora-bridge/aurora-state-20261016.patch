+#pragma once
+
+#include "common.hpp"
+
+namespace aurora::gfx::efb_peek {
+// Render worker only. Read both attachments at the same render checkpoint.
+void encode(const wgpu::CommandEncoder& cmd, const wgpu::TextureView& color,
+            const wgpu::TextureView& depth, wgpu::Extent3D sourceSize,
+            Vec2<uint32_t> logicalSize, uint32_t samples,
+            Vec2<uint32_t> origin, Vec2<uint32_t> extent, bool exactDepth = false);
+void complete();
+// Render worker, after submission: no stale cache, waits for this exact copy.
+bool complete_depth(std::vector<uint32_t>& depth);
+// Render worker, after submission: maps this exact copy without waiting. The
+// result is collected later with take_depth under the same tag.
+bool request_depth(uint64_t tag);
+// Any thread: whether no exact depth copy is encoding or mapping.
+bool exact_depth_idle();
+// Recording thread: the finished asynchronous depth copy, once.
+bool take_depth(uint64_t& tag, std::vector<uint32_t>& depth, bool& success);
+// Recording thread, after render_worker::synchronize().
+bool contains(uint32_t x, uint32_t y);
+bool is_full();
+bool read(uint32_t x, uint32_t y, uint32_t& argb, uint32_t& z);
+void shutdown();
+} // namespace aurora::gfx::efb_peek

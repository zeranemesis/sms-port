+static bool peek_efb_impl(uint32_t x, uint32_t y, uint64_t revision, uint32_t& argb, uint32_t& z,
+                          const ClipRect* exactRect = nullptr, std::vector<uint32_t>* exactDepth = nullptr,
+                          bool submitOnly = false, uint64_t asyncDepthTag = 0) {
+  if (!g_recordingFrame || g_currentRenderPass==UINT32_MAX || g_inOffscreen) return false;
+  const auto logicalSize=gx::logical_fb_size();
+  if (x>=logicalSize.x || y>=logicalSize.y) return false;
+  static uint64_t cachedFrame=0, cachedRevision=0;
+  static uint32_t cachedRequests=2; // Start with a full image until the query pattern is known.
+  static bool comparing=false;
+  static const bool forceFull=[] { const char* v=std::getenv("SMS_AURORA_EFB_FULL"); return v&&*v&&std::strcmp(v,"0"); }();
+  static const bool compare=[] { const char* v=std::getenv("SMS_AURORA_EFB_COMPARE"); return v&&*v&&std::strcmp(v,"0"); }();
+  auto& frame=current_frame_packet();
+  const bool exact = exactRect != nullptr;
+  const bool changed=submitOnly || exact || cachedFrame!=frame.frameId || cachedRevision!=revision;
+  bool exactSuccess = false;
+  if (changed || !efb_peek::contains(x,y) || (comparing && !efb_peek::is_full())) {
+    Vec2<uint32_t> origin{},extent=logicalSize;
+    if (exact) {
+      origin = {uint32_t(exactRect->x), uint32_t(exactRect->y)};
+      extent = {uint32_t(exactRect->width), uint32_t(exactRect->height)};
+    }
+    // Adaptive 128x128 tile covers clustered sun glare probes (~80px spread) without fallback.
+    if(changed && !forceFull && !comparing && !exact) {
+      origin={x&~127u,y&~127u};
+      extent={std::min(128u,logicalSize.x-origin.x),std::min(128u,logicalSize.y-origin.y)};
+    }
+    if(changed) cachedRequests=0;
+    static FILE* profile=[] {
+      const auto* path=std::getenv("SMS_AURORA_PEEK_PROFILE");
+      FILE* file=path&&*path ? std::fopen(path,"w") : nullptr;
+      if(file) std::setvbuf(file,nullptr,_IOFBF,8192);
+      return file;
+    }();
+    using Clock=std::chrono::steady_clock;
+    const auto stamp=[&] { return profile ? Clock::now() : Clock::time_point{}; };
+    const auto t0=stamp();
+    // Seal exactly the draws preceding GXPeek, before later HUD/pollution clears.
+    frame.uniforms.append_zeroes(gx::MaxUniformSize);
+    std::array<ByteBuffer*,5> buffers{&frame.verts,&frame.uniforms,&frame.indices,&frame.storage,&frame.textureUpload};
+    // Copies resume at a four-byte aligned high-water mark. Upload alignment
+    // padding now so the continuation never fetches a skipped prefix byte.
+    for(auto* buffer:buffers) buffer->append_zeroes(AURORA_ALIGN(buffer->size(),4)-buffer->size());
+    auto& oldPass=frame.renderPasses[g_currentRenderPass];
+    oldPass.observable=true;
+    const auto color=oldPass.colorView, depth=oldPass.copySourceDepthView;
+    const auto size=oldPass.targetSize;
+    const auto samples=oldPass.msaaSamples;
+    enqueue_pass(frame,g_recordingFrameSlot,g_currentRenderPass);
+    // Continue in another mapped pool slot without cloning upload memory.
+    // enqueue_pass uploads the entire sealed prefix to the shared GPU buffers;
+    // frame.copied prevents it being uploaded again. All recording access is
+    // append-only, and the original GPU offsets remain valid across checkpoints.
+    const auto nextStaging=acquire_mapped_staging_buffer();

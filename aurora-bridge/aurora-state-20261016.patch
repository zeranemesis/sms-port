+      wgpu::BindGroupLayoutEntry{.binding=2, .visibility=wgpu::ShaderStage::Compute,
+          .buffer=wgpu::BufferBindingLayout{.type=wgpu::BufferBindingType::Storage}},
+      wgpu::BindGroupLayoutEntry{.binding=3, .visibility=wgpu::ShaderStage::Compute,
+          .buffer=wgpu::BufferBindingLayout{.type=wgpu::BufferBindingType::Uniform}},
+  };
+  const wgpu::BindGroupLayoutDescriptor layoutDesc{.label="EFB peek layout",
+      .entryCount=entries.size(), .entries=entries.data()};
+  Pipeline result;
+  result.layout=g_device.CreateBindGroupLayout(&layoutDesc);
+  std::string source=multisampled
+      ? "@group(0) @binding(0) var color: texture_multisampled_2d<f32>;\n"
+        "@group(0) @binding(1) var depth: texture_depth_multisampled_2d;\n"
+      : "@group(0) @binding(0) var color: texture_2d<f32>;\n"
+        "@group(0) @binding(1) var depth: texture_depth_2d;\n";
+  source+=R"(
+struct Params { size: vec2u, sourceSize: vec2u, origin: vec2u, logicalSize: vec2u };
+@group(0) @binding(2) var<storage, read_write> pixels: array<vec2u>;
+@group(0) @binding(3) var<uniform> params: Params;
+@compute @workgroup_size(8, 8, 1)
+fn cs_main(@builtin(global_invocation_id) id: vec3u) {
+    if (any(id.xy >= params.size)) { return; }
+    let p = min(vec2u((vec2f(id.xy + params.origin) + vec2f(0.5)) * vec2f(params.sourceSize) / vec2f(params.logicalSize)),
+                params.sourceSize - vec2u(1));
+    // Sample zero for both attachments: depth is never averaged across an edge.
+    let rgba = pack4x8unorm(textureLoad(color, vec2i(p), 0));
+    let d = textureLoad(depth, vec2i(p), 0);
+)";
+  source+=gx::UseReversedZ ? "    let forward = 1.0 - d;\n" : "    let forward = d;\n";
+  source+=R"(
+    let z = min(u32(clamp(forward, 0.0, 1.0) * 16777215.0 + 0.5), 0x00ffffffu);
+    let argb = (rgba & 0xff00ff00u) | ((rgba & 0xffu) << 16u) | ((rgba >> 16u) & 0xffu);
+    pixels[id.y * params.size.x + id.x] = vec2u(argb, z);
+}
+)";
+  const wgpu::ShaderSourceWGSL wgsl{wgpu::ShaderSourceWGSL::Init{.code=source.c_str()}};
+  const wgpu::ShaderModuleDescriptor moduleDesc{.nextInChain=&wgsl, .label="EFB peek shader"};
+  const auto module=g_device.CreateShaderModule(&moduleDesc);
+  const wgpu::PipelineLayoutDescriptor pipelineLayoutDesc{.bindGroupLayoutCount=1,
+      .bindGroupLayouts=&result.layout};
+  const auto layout=g_device.CreatePipelineLayout(&pipelineLayoutDesc);
+  const wgpu::ComputePipelineDescriptor pipelineDesc{.label="EFB peek pipeline", .layout=layout,
+      .compute=wgpu::ComputeState{.module=module, .entryPoint="cs_main"}};
+  result.pipeline=g_device.CreateComputePipeline(&pipelineDesc);
+  return result;
+}
+} // namespace
+
+void encode(const wgpu::CommandEncoder& cmd, const wgpu::TextureView& color,
+            const wgpu::TextureView& depth, wgpu::Extent3D sourceSize,
+            Vec2<uint32_t> logicalSize, uint32_t samples,
+            Vec2<uint32_t> origin, Vec2<uint32_t> extent, bool exactDepth) {
+  ASSERT(render_worker::is_worker_thread(), "EFB peek must be encoded by the render worker");
+  CHECK(color && depth && logicalSize.x && logicalSize.y, "Invalid EFB peek attachments");
+  g_size=logicalSize;
+  CHECK(extent.x && extent.y && origin.x<logicalSize.x && origin.y<logicalSize.y &&
+        extent.x<=logicalSize.x-origin.x && extent.y<=logicalSize.y-origin.y,"Invalid EFB peek region");
+
+  int chosen = exactDepth ? int(ExactDepthSlot) : -1;
+  CHECK(!exactDepth || g_slots[ExactDepthSlot].state.load(std::memory_order_acquire) == SlotState::Available,
+        "Exact depth checkpoint is already in flight");
+  for (size_t i = 0; chosen < 0 && i < AsyncSlotCount; ++i) {
+    if (g_slots[i].state.load(std::memory_order_acquire) == SlotState::Available) {
+      chosen = int(i);
+      break;
+    }
+  }
+  if (chosen < 0 && g_instance) {
+    g_instance.ProcessEvents();
+    for (size_t i = 0; i < AsyncSlotCount; ++i) {
+      if (g_slots[i].state.load(std::memory_order_acquire) == SlotState::Available) {
+        chosen = int(i);
+        break;
+      }
+    }
+  }
+  if (chosen < 0) {
+    // Si tous les slots sont occupés et qu'on a déjà des données en cache,
+    // on ne surcharge pas Dawn avec une requête concurrente redondante.
+    g_activeEncodingSlot = -1;
+    return;
+  }
+
+  g_activeEncodingSlot = chosen;
+  auto& slot = g_slots[chosen];
+  slot.state.store(SlotState::Encoding, std::memory_order_release);
+  slot.origin = origin;
+  slot.extent = extent;
+  slot.bytes = uint64_t(extent.x)*extent.y*8;
+  wgpu::Limits limits;
+  g_device.GetLimits(&limits);
+  CHECK(slot.bytes<=limits.maxStorageBufferBindingSize, "EFB peek exceeds GPU buffer limits");
+
+  if (slot.capacity < slot.bytes) {
+    const wgpu::BufferDescriptor storageDesc{.label="EFB peek storage",
+        .usage=wgpu::BufferUsage::Storage|wgpu::BufferUsage::CopySrc, .size=slot.bytes};
+    slot.storage=g_device.CreateBuffer(&storageDesc);
+    const wgpu::BufferDescriptor readDesc{.label="EFB peek readback",
+        .usage=wgpu::BufferUsage::CopyDst|wgpu::BufferUsage::MapRead, .size=slot.bytes};
+    slot.readback=g_device.CreateBuffer(&readDesc);
+    slot.capacity=slot.bytes;
+  }
+  if (!g_params) {
+    const wgpu::BufferDescriptor paramsDesc{.label="EFB peek parameters",
+        .usage=wgpu::BufferUsage::Uniform|wgpu::BufferUsage::CopyDst, .size=sizeof(Params)};
+    g_params=g_device.CreateBuffer(&paramsDesc);
+  }
+  const Params params{extent.x,extent.y,sourceSize.width,sourceSize.height,origin.x,origin.y,logicalSize.x,logicalSize.y};
+  g_queue.WriteBuffer(g_params,0,&params,sizeof(params));
+  auto& pipeline=g_pipelines[samples>1 ? 1 : 0];
+  if (!pipeline.pipeline) pipeline=create_pipeline(samples>1);
+  const std::array entries{
+      wgpu::BindGroupEntry{.binding=0, .textureView=color},
+      wgpu::BindGroupEntry{.binding=1, .textureView=depth},
+      wgpu::BindGroupEntry{.binding=2, .buffer=slot.storage, .size=slot.bytes},
+      wgpu::BindGroupEntry{.binding=3, .buffer=g_params, .size=sizeof(Params)},
+  };
+  const wgpu::BindGroupDescriptor bindDesc{.label="EFB peek bind group", .layout=pipeline.layout,
+      .entryCount=entries.size(), .entries=entries.data()};
+  const auto bind=g_device.CreateBindGroup(&bindDesc);
+  const wgpu::ComputePassDescriptor passDesc{.label="EFB peek checkpoint"};
+  const auto pass=cmd.BeginComputePass(&passDesc);
+  pass.SetPipeline(pipeline.pipeline);
+  pass.SetBindGroup(0,bind);
+  pass.DispatchWorkgroups((extent.x+7)/8,(extent.y+7)/8);
+  pass.End();
+  cmd.CopyBufferToBuffer(slot.storage,0,slot.readback,0,slot.bytes);
+}
+
+bool complete_depth(std::vector<uint32_t>& depth) {
+  ASSERT(render_worker::is_worker_thread(), "Exact EFB depth must complete on the render worker");
+  if (g_activeEncodingSlot != int(ExactDepthSlot)) return false;
+  g_activeEncodingSlot = -1;
+  auto& slot = g_slots[ExactDepthSlot];
+  slot.state.store(SlotState::MapPending, std::memory_order_release);
+  const auto buffer = slot.readback;
+  auto mapped = std::make_shared<std::atomic_bool>(false);
+  const auto future = buffer.MapAsync(wgpu::MapMode::Read, 0, slot.bytes, wgpu::CallbackMode::WaitAnyOnly,
+      [mapped](wgpu::MapAsyncStatus status, wgpu::StringView) {
+        mapped->store(status == wgpu::MapAsyncStatus::Success, std::memory_order_release);
+      });
+  const auto status = g_instance.WaitAny(future, 5'000'000'000);
+  bool success = status == wgpu::WaitStatus::Success && mapped->load(std::memory_order_acquire);
+  std::vector<uint32_t> result;
+  if (success) {
+    const auto* pixels = static_cast<const uint32_t*>(buffer.GetConstMappedRange(0, slot.bytes));
+    success = pixels != nullptr;
+    if (pixels) {
+      result.resize(size_t(slot.extent.x) * slot.extent.y);
+      for (size_t i = 0; i < result.size(); ++i) result[i] = pixels[i * 2 + 1];
+    }
+  }
+  // Abort a timed-out map too. Its callback owns only the status flag, never
+  // references this slot or the caller's output after the bounded wait ends.
+  buffer.Unmap();
+  slot.state.store(SlotState::Available, std::memory_order_release);
+  if (success) depth = std::move(result);
+  else Log.warn("Exact EFB depth mapping failed; CPU destination was not modified");
+  return success;
+}
+
+namespace {
+struct DepthResult {
+  uint64_t tag = 0;
+  std::vector<uint32_t> depth;
+  bool ready = false;
+  bool success = false;
+};
+std::mutex g_depthMutex;
+DepthResult g_depthResult;
+} // namespace
+
+bool request_depth(uint64_t tag) {
+  ASSERT(render_worker::is_worker_thread(), "Exact EFB depth must be requested on the render worker");
+  if (g_activeEncodingSlot != int(ExactDepthSlot)) return false;
+  g_activeEncodingSlot = -1;
+  auto& slot = g_slots[ExactDepthSlot];
+  slot.state.store(SlotState::MapPending, std::memory_order_release);
+  const auto readback = slot.readback;
+  const uint64_t bytes = slot.bytes;
+  const size_t pixels = size_t(slot.extent.x) * slot.extent.y;
+  readback.MapAsync(wgpu::MapMode::Read, 0, bytes, wgpu::CallbackMode::AllowSpontaneous,
+      [tag, readback, bytes, pixels](wgpu::MapAsyncStatus status, wgpu::StringView) {
+        std::vector<uint32_t> depth;
+        bool success = false;
+        if (status == wgpu::MapAsyncStatus::Success) {
+          if (const auto* data = static_cast<const uint32_t*>(readback.GetConstMappedRange(0, bytes))) {
+            depth.resize(pixels);
+            for (size_t i = 0; i < pixels; ++i) depth[i] = data[i * 2 + 1];
+            success = true;
+          }
+          readback.Unmap();
+        }
+        {
+          std::lock_guard lock(g_depthMutex);
+          g_depthResult.tag = tag;
+          g_depthResult.depth = std::move(depth);
+          g_depthResult.ready = true;
+          g_depthResult.success = success;
+        }
+        g_slots[ExactDepthSlot].state.store(SlotState::Available, std::memory_order_release);
+      });
+  return true;
+}
+
+bool exact_depth_idle() {
+  return g_slots[ExactDepthSlot].state.load(std::memory_order_acquire) == SlotState::Available;
+}
+
+bool take_depth(uint64_t& tag, std::vector<uint32_t>& depth, bool& success) {
+  std::lock_guard lock(g_depthMutex);
+  if (!g_depthResult.ready) return false;
+  tag = g_depthResult.tag;
+  success = g_depthResult.success;
+  depth = std::move(g_depthResult.depth);
+  g_depthResult = {};
+  return true;
+}
+
+void complete() {
+  if (g_activeEncodingSlot < 0) return;
+  const size_t slotIdx = size_t(g_activeEncodingSlot);
+  g_activeEncodingSlot = -1;
+  auto& slot = g_slots[slotIdx];
+  slot.state.store(SlotState::MapPending, std::memory_order_release);
+
+  static const bool asyncMode = [] {
+    const char* v = std::getenv("SMS_AURORA_EFB_ASYNC");
+    return !v || (*v && std::strcmp(v, "0") != 0);
+  }();
+
+  if (!asyncMode) {
+    auto success=std::make_shared<bool>(false);
+    const auto future=slot.readback.MapAsync(wgpu::MapMode::Read,0,slot.bytes,wgpu::CallbackMode::WaitAnyOnly,
+        [success](wgpu::MapAsyncStatus status,wgpu::StringView) { *success=status==wgpu::MapAsyncStatus::Success; });
+    const auto status=g_instance.WaitAny(future,5'000'000'000);
+    CHECK(status==wgpu::WaitStatus::Success && *success, "EFB peek GPU readback failed or timed out");
+    const auto* data=static_cast<const uint32_t*>(slot.readback.GetConstMappedRange(0,slot.bytes));
+    CHECK(data!=nullptr, "EFB peek returned an empty mapping");
+    g_cachedPixels.assign(data,data+slot.bytes/4);
+    g_cachedOrigin = slot.origin;
+    g_cachedExtent = slot.extent;
+    g_hasCachedData.store(true, std::memory_order_release);
+    slot.readback.Unmap();
+    slot.state.store(SlotState::Available, std::memory_order_release);
+    return;
+  }
+
+  // Mode asynchrone :
+  // Première trame du jeu : amorçage synchrone pour avoir la base de données de départ
+  if (!g_hasCachedData.load(std::memory_order_acquire)) {
+    auto success=std::make_shared<bool>(false);
+    const auto future=slot.readback.MapAsync(wgpu::MapMode::Read,0,slot.bytes,wgpu::CallbackMode::WaitAnyOnly,
+        [success](wgpu::MapAsyncStatus status,wgpu::StringView) { *success=status==wgpu::MapAsyncStatus::Success; });
+    const auto status=g_instance.WaitAny(future,5'000'000'000);
+    if (status==wgpu::WaitStatus::Success && *success) {
+      const auto* data=static_cast<const uint32_t*>(slot.readback.GetConstMappedRange(0,slot.bytes));
+      if (data) {
+        g_cachedPixels.assign(data,data+slot.bytes/4);
+        g_cachedOrigin = slot.origin;
+        g_cachedExtent = slot.extent;
+        g_hasCachedData.store(true, std::memory_order_release);
+      }
+      slot.readback.Unmap();
+    }
+    slot.state.store(SlotState::Available, std::memory_order_release);
+    return;
+  }
+
+  // En cours de jeu : MapAsync spontané sans bloquer le render worker !
+  const auto readback = slot.readback;
+  const uint64_t bytes = slot.bytes;
+  const auto origin = slot.origin;
+  const auto extent = slot.extent;
+
+  readback.MapAsync(wgpu::MapMode::Read, 0, bytes, wgpu::CallbackMode::AllowSpontaneous,
+      [slotIdx, readback, bytes, origin, extent](wgpu::MapAsyncStatus status, wgpu::StringView) {
+        if (status == wgpu::MapAsyncStatus::Success) {
+          const auto* data = static_cast<const uint32_t*>(readback.GetConstMappedRange(0, bytes));
+          if (data) {
+            g_cachedPixels.assign(data, data + bytes / 4);
+            g_cachedOrigin = origin;
+            g_cachedExtent = extent;
+            g_hasCachedData.store(true, std::memory_order_release);
+          }
+          readback.Unmap();
+        }
+        g_slots[slotIdx].state.store(SlotState::Available, std::memory_order_release);
+      });
+}
+
+bool contains(uint32_t x,uint32_t y) {
+  if (!g_hasCachedData.load(std::memory_order_acquire)) return false;
+  return x>=g_cachedOrigin.x && y>=g_cachedOrigin.y &&
+         x-g_cachedOrigin.x<g_cachedExtent.x &&
+         y-g_cachedOrigin.y<g_cachedExtent.y;
+}
+
+bool is_full() {
+  if (!g_hasCachedData.load(std::memory_order_acquire)) return false;
+  return g_cachedOrigin.x==0 && g_cachedOrigin.y==0 &&
+         g_cachedExtent.x==g_size.x && g_cachedExtent.y==g_size.y;
+}
+
+bool read(uint32_t x,uint32_t y,uint32_t& argb,uint32_t& z) {
+  if (!contains(x,y) || g_cachedPixels.empty()) return false;
+  const auto offset=(size_t(y-g_cachedOrigin.y)*g_cachedExtent.x+x-g_cachedOrigin.x)*2;
+  if (offset + 1 >= g_cachedPixels.size()) return false;
+  argb=g_cachedPixels[offset]; z=g_cachedPixels[offset+1];
+  return true;
+}
+
+void shutdown() {
+  g_cachedPixels.clear(); g_size={}; g_cachedOrigin={}; g_cachedExtent={};
+  {
+    std::lock_guard lock(g_depthMutex);
+    g_depthResult = {};
+  }
+  g_hasCachedData.store(false, std::memory_order_release);
+  for (auto& s : g_slots) {
+    s.storage={}; s.readback={}; s.capacity=0; s.bytes=0; s.origin={}; s.extent={};
+    s.state.store(SlotState::Available, std::memory_order_release);
+  }
+  g_activeEncodingSlot = -1;
+  g_params={}; g_pipelines={};
+}
+} // namespace aurora::gfx::efb_peek

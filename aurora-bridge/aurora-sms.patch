+          std::fprintf(file,"%llu pass %u commands %zu cpu_ms %.3f gpu_ms %.3f\n",
+              (unsigned long long)packet.frameId,timing.passIndex,timing.commands,timing.cpuMs,
+              double(values[1]-values[0])*1e-6);
+          timing.readback.Unmap();
+        }
+        packet.passTimings.clear();
+      }
+      packet.stagingBuffer=nextStaging;
+      map_staging_buffer(staging,true);
+      const wgpu::CommandEncoderDescriptor desc{.label="Continue after EFB peek"};
+      packet.encoder=g_device.CreateCommandEncoder(&desc);
+    });
+    render_worker::synchronize();
+    CHECK(frame.copied.verts==frame.verts.size() && frame.copied.uniforms==frame.uniforms.size() &&
+          frame.copied.indices==frame.indices.size() && frame.copied.storage==frame.storage.size(),
+          "EFB checkpoint must upload the prefix before staging rotation");
+    if constexpr(UseTextureBuffer) {
+      CHECK(frame.copied.textureUpload==frame.textureUpload.size() &&
+            frame.copied.textureUploadCount==frame.textureUploads.size(),
+            "EFB checkpoint must upload pending textures before staging rotation");
+    }
+    const auto t3=stamp();
+    if(profile) {
+      const auto ms=[](auto a,auto b) { return std::chrono::duration<double,std::milli>(b-a).count(); };
+      std::fprintf(profile,"%llu %llu xy %u %u bytes %llu stage %.3f clone %.3f backlog %.3f encode %.3f readback %.3f total %.3f\n",
+          (unsigned long long)frame.frameId,(unsigned long long)revision,x,y,(unsigned long long)copiedBytes,
+          ms(t0,t1),ms(t1,t2),ms(t2,workerStart),ms(workerStart,workerSubmitted),
+          ms(workerSubmitted,workerComplete),ms(t0,t3));
+    }
+    for (size_t i=0;i<buffers.size();++i) {
+      *buffers[i]=std::move(nextBuffers[i]);
+    }
+    RenderPass next;
+    set_efb_targets(next);
+    next.clearColor=false; next.clearDepth=false;
+    next.commands.reserve(2048);
+    frame.renderPasses.emplace_back(std::move(next));
+    g_currentRenderPass=static_cast<uint32_t>(frame.renderPasses.size()-1);
+    push_command(CommandType::SetViewport,Command::Data{.setViewport=g_cachedViewport});
+    push_command(CommandType::SetScissor,Command::Data{.setScissor=g_cachedScissor});
+    cachedFrame=(exact || submitOnly) ? 0 : frame.frameId; cachedRevision=revision;
+  }
+  if (submitOnly) return true;
+  if (exact) return exactSuccess;
+  if (!efb_peek::read(x,y,argb,z)) return false;
+  if (gx::g_gxState.pixelFmt!=GX_PF_RGBA6_Z24) argb|=0xff000000u;
+  if(!comparing) ++cachedRequests;
+  if(compare && !comparing && !efb_peek::is_full()) {
+    uint32_t referenceColor=0,referenceZ=0;
+    comparing=true;
+    const bool valid=peek_efb(x,y,revision,referenceColor,referenceZ);
+    comparing=false;
+    CHECK(valid && argb==referenceColor && z==referenceZ,"Sparse EFB read differs from full checkpoint");
+    static uint32_t checked=0;
+    if(++checked%120==0) std::fprintf(stderr,"[efb-compare] %u sparse reads equal full checkpoints\n",checked);
+  }
+  return true;
+}
+
+bool peek_efb(uint32_t x, uint32_t y, uint64_t revision, uint32_t& argb, uint32_t& z) {
+  return peek_efb_impl(x, y, revision, argb, z);
+}
+
+bool submit_copy_checkpoint() {
+  // Preserve the sealed prefix and staging rotation without encoding a depth
+  // read whose pixels are discarded. The caller waits for actual copy maps.
+  uint32_t argb = 0, z = 0;
+  return peek_efb_impl(0, 0, 0, argb, z, nullptr, nullptr, true);
+}
+
+bool copy_depth_efb(ClipRect rect, std::vector<uint32_t>& depth) {
+  const auto size = gx::logical_fb_size();
+  if (rect.x < 0 || rect.y < 0 || rect.width <= 0 || rect.height <= 0 ||
+      uint32_t(rect.x) >= size.x || uint32_t(rect.y) >= size.y ||
+      uint32_t(rect.width) > size.x - uint32_t(rect.x) ||
+      uint32_t(rect.height) > size.y - uint32_t(rect.y)) return false;
+  uint32_t argb = 0, z = 0;
+  return peek_efb_impl(uint32_t(rect.x), uint32_t(rect.y), 0, argb, z, &rect, &depth);
+}
+
+bool request_depth_efb_async(ClipRect rect, uint64_t tag) {
+  const auto size = gx::logical_fb_size();
+  if (tag == 0 || rect.x < 0 || rect.y < 0 || rect.width <= 0 || rect.height <= 0 ||
+      uint32_t(rect.x) >= size.x || uint32_t(rect.y) >= size.y ||
+      uint32_t(rect.width) > size.x - uint32_t(rect.x) ||
+      uint32_t(rect.height) > size.y - uint32_t(rect.y)) return false;
+  // One exact copy maps at a time; a request made while the previous one is
+  // still in flight is skipped and the caller keeps the older result.
+  if (!efb_peek::exact_depth_idle()) return false;
+  uint32_t argb = 0, z = 0;
+  return peek_efb_impl(uint32_t(rect.x), uint32_t(rect.y), 0, argb, z, &rect, nullptr, false, tag);
+}
+
+bool take_depth_efb_async(uint64_t& tag, std::vector<uint32_t>& depth, bool& success) {
+  return efb_peek::take_depth(tag, depth, success);
+}

+// A query that fails leaves its statement needing a reset; without one every
+// later bind fails too ("bad parameter or other API misuse"). Corruption found
+// mid-session disables the cache instead of retrying it on every shader; the
+// next launch's integrity check rebuilds the file.
+static void query_failed(sqlite3_stmt* stmt, int ret, const char* what) {
+  sqlite3_reset(stmt);
+  sqlite3_clear_bindings(stmt);
+  if (sqlite::is_corruption(ret)) {
+    Log.error("{} failed: {}; disabling the Dawn cache for this session", what, sqlite3_errmsg(db));
+    cache_broken = true;
+    return;
+  }
+  Log.error("{} failed: {}", what, sqlite3_errmsg(db));
+}

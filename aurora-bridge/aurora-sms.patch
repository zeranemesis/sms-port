diff --git a/lib/gfx/sms_readback.cpp b/lib/gfx/sms_readback.cpp
new file mode 100644
index 0000000..30fb645
--- /dev/null
+++ b/lib/gfx/sms_readback.cpp
@@ -0,0 +1,418 @@
+#include "sms_readback.hpp"
+
+#include <aurora/sms_ext.h>
+
+#include "../dolphin/vi/vi_internal.hpp"
+#include "../gx/gx.hpp"
+#include "../webgpu/gpu.hpp"
+
+#include <algorithm>
+#include <array>
+#include <deque>
+#include <mutex>
+#include <vector>
+
+namespace aurora::gfx::sms_readback {
+namespace {
+Module Log("aurora::gfx::sms_readback");
+
+using webgpu::g_device;
+using webgpu::g_queue;
+
+constexpr uint64_t CounterBytes = AURORA_SMS_PIXEL_METRIC_SLOTS * sizeof(uint32_t);
+constexpr size_t CounterSlots = 4;
+constexpr size_t CopySlots = 8;
+
+enum class SlotState : uint8_t { Available, CopySubmitted, MapPending };
+
+struct CounterSlot {
+  wgpu::Buffer buffer;
+  uint64_t frameId = 0;
+  SlotState state = SlotState::Available;
+};
+
+struct CopySlot {
+  wgpu::Buffer storage;
+  wgpu::Buffer readback;
+  wgpu::Buffer params;
+  uint64_t capacity = 0;
+  CopyRequest req;
+  uint64_t frameId = 0;
+  SlotState state = SlotState::Available;
+};
+
+struct CopyResult {
+  CopyRequest req;
+  uint64_t frameId = 0;
+  std::vector<uint32_t> rgba;
+};
+
+struct Params {
+  uint32_t dstWidth, dstHeight;
+  int32_t srcX, srcY;
+  float scaleX, scaleY;
+  uint32_t pad0, pad1;
+};
+static_assert(sizeof(Params) == 32);
+
+wgpu::Buffer g_counters;
+std::array<CounterSlot, CounterSlots> g_counterSlots;
+std::array<CopySlot, CopySlots> g_copySlots;
+wgpu::BindGroupLayout g_copyLayout;
+wgpu::ComputePipeline g_copyPipeline;
+std::mutex g_mutex;
+uint64_t g_generation = 0;
+bool g_active = false;
+uint64_t g_latestCountsFrame = 0;
+bool g_latestCountsNew = false;
+std::vector<uint32_t> g_latestCounts;
+std::vector<uint32_t> g_returnedCounts;
+std::deque<CopyResult> g_copyResults;
+CopyResult g_returnedCopy;
+CopyRequest g_pendingCopy;
+
+constexpr const char* CopyShader = R"(
+struct Params {
+    dstSize: vec2u,
+    srcOrigin: vec2i,
+    scale: vec2f,
+    pad: vec2u,
+};
+@group(0) @binding(0) var src: texture_2d<f32>;
+@group(0) @binding(1) var<storage, read_write> out_px: array<u32>;
+@group(0) @binding(2) var<uniform> params: Params;
+
+@compute @workgroup_size(8, 8, 1)
+fn cs_main(@builtin(global_invocation_id) id: vec3u) {
+    if (id.x >= params.dstSize.x || id.y >= params.dstSize.y) {
+        return;
+    }
+    let srcSize = vec2i(textureDimensions(src));
+    let p = clamp(params.srcOrigin + vec2i(floor((vec2f(id.xy) + vec2f(0.5)) * params.scale)), vec2i(0),
+                  srcSize - vec2i(1));
+    let c = textureLoad(src, p, 0);
+    out_px[id.y * params.dstSize.x + id.x] = pack4x8unorm(c);
+}
+)";
+
+void create_copy_pipeline() {
+  const std::array entries{
+      wgpu::BindGroupLayoutEntry{
+          .binding = 0,
+          .visibility = wgpu::ShaderStage::Compute,
+          .texture = wgpu::TextureBindingLayout{.sampleType = wgpu::TextureSampleType::Float,
+                                                .viewDimension = wgpu::TextureViewDimension::e2D},
+      },
+      wgpu::BindGroupLayoutEntry{
+          .binding = 1,
+          .visibility = wgpu::ShaderStage::Compute,
+          .buffer = wgpu::BufferBindingLayout{.type = wgpu::BufferBindingType::Storage},
+      },
+      wgpu::BindGroupLayoutEntry{
+          .binding = 2,
+          .visibility = wgpu::ShaderStage::Compute,
+          .buffer = wgpu::BufferBindingLayout{.type = wgpu::BufferBindingType::Uniform},
+      },
+  };
+  const wgpu::BindGroupLayoutDescriptor layoutDesc{
+      .label = "SMS copy read-back layout",
+      .entryCount = entries.size(),
+      .entries = entries.data(),
+  };
+  g_copyLayout = g_device.CreateBindGroupLayout(&layoutDesc);
+  const wgpu::ShaderSourceWGSL wgsl{wgpu::ShaderSourceWGSL::Init{.code = CopyShader}};
+  const wgpu::ShaderModuleDescriptor moduleDesc{.nextInChain = &wgsl, .label = "SMS copy read-back"};
+  const auto module = g_device.CreateShaderModule(&moduleDesc);
+  const wgpu::PipelineLayoutDescriptor plDesc{.bindGroupLayoutCount = 1, .bindGroupLayouts = &g_copyLayout};
+  const auto pipelineLayout = g_device.CreatePipelineLayout(&plDesc);
+  const wgpu::ComputePipelineDescriptor desc{
+      .label = "SMS copy read-back",
+      .layout = pipelineLayout,
+      .compute = wgpu::ComputeState{.module = module, .entryPoint = "cs_main"},
+  };
+  g_copyPipeline = g_device.CreateComputePipeline(&desc);
+}
+
+bool ensure_copy_slot(CopySlot& slot, uint64_t bytes) {
+  if (slot.storage && slot.capacity >= bytes) {
+    return true;
+  }
+  slot.capacity = std::max<uint64_t>(bytes, 64 * 1024);
+  const wgpu::BufferDescriptor storageDesc{
+      .label = "SMS copy read-back storage",
+      .usage = wgpu::BufferUsage::Storage | wgpu::BufferUsage::CopySrc,
+      .size = slot.capacity,
+  };
+  slot.storage = g_device.CreateBuffer(&storageDesc);
+  const wgpu::BufferDescriptor readbackDesc{
+      .label = "SMS copy read-back",
+      .usage = wgpu::BufferUsage::MapRead | wgpu::BufferUsage::CopyDst,
+      .size = slot.capacity,
+  };
+  slot.readback = g_device.CreateBuffer(&readbackDesc);
+  if (!slot.params) {
+    const wgpu::BufferDescriptor paramsDesc{
+        .label = "SMS copy read-back params",
+        .usage = wgpu::BufferUsage::Uniform | wgpu::BufferUsage::CopyDst,
+        .size = sizeof(Params),
+    };
+    slot.params = g_device.CreateBuffer(&paramsDesc);
+  }
+  return slot.storage && slot.readback && slot.params;
+}
+} // namespace
+
+void initialize() {
+  {
+    std::lock_guard lock{g_mutex};
+    ++g_generation;
+    g_active = true;
+    g_latestCountsFrame = 0;
+    g_latestCountsNew = false;
+    g_latestCounts.clear();
+    g_copyResults.clear();
+  }
+  const wgpu::BufferDescriptor counterDesc{
+      .label = "SMS pixel metric counters",
+      .usage = wgpu::BufferUsage::Storage | wgpu::BufferUsage::CopySrc | wgpu::BufferUsage::CopyDst,
+      .size = CounterBytes,
+  };
+  g_counters = g_device.CreateBuffer(&counterDesc);
+  for (auto& slot : g_counterSlots) {
+    const wgpu::BufferDescriptor desc{
+        .label = "SMS pixel metric read-back",
+        .usage = wgpu::BufferUsage::MapRead | wgpu::BufferUsage::CopyDst,
+        .size = CounterBytes,
+    };
+    slot.buffer = g_device.CreateBuffer(&desc);
+    slot.state = SlotState::Available;
+  }
+  create_copy_pipeline();
+}
+
+void shutdown() {
+  {
+    std::lock_guard lock{g_mutex};
+    g_active = false;
+    ++g_generation;
+    g_copyResults.clear();
+    g_latestCountsNew = false;
+  }
+  // Releasing a buffer may dispatch an aborted map callback. Never release
+  // Dawn objects while holding the mutex those callbacks acquire.
+  g_counters = {};
+  for (auto& slot : g_counterSlots) {
+    slot = {};
+  }
+  for (auto& slot : g_copySlots) {
+    slot = {};
+  }
+  g_copyPipeline = {};
+  g_copyLayout = {};
+}
+
+const wgpu::Buffer& counter_buffer() noexcept { return g_counters; }
+
+void begin_frame_encode(const wgpu::CommandEncoder& cmd) noexcept {
+  if (g_counters) {
+    cmd.ClearBuffer(g_counters, 0, CounterBytes);
+  }
+}
+
+void end_frame_encode(const wgpu::CommandEncoder& cmd, uint64_t frameId) noexcept {
+  if (!g_counters) {
+    return;
+  }
+  CounterSlot* selected = nullptr;
+  {
+    std::lock_guard lock{g_mutex};
+    for (auto& slot : g_counterSlots) {
+      if (slot.state != SlotState::Available) continue;
+      slot.frameId = frameId;
+      slot.state = SlotState::CopySubmitted;
+      selected = &slot;
+      break;
+    }
+  }
+  // CopyBufferToBuffer can also allow pending spontaneous callbacks to run.
+  if (selected) cmd.CopyBufferToBuffer(g_counters, 0, selected->buffer, 0, CounterBytes);
+  // Every read-back buffer mapping: this frame's counts are skipped.
+}
+
+void encode_copy(const wgpu::CommandEncoder& cmd, const wgpu::TextureView& efbColor, ClipRect rect,
+                 const CopyRequest& req, uint64_t frameId) noexcept {
+  if (!g_copyPipeline || !efbColor || req.width == 0 || req.height == 0 || rect.width <= 0 || rect.height <= 0) {
+    return;
+  }
+  const uint64_t bytes = uint64_t(req.width) * req.height * 4;
+  CopySlot* slot = nullptr;
+  {
+    std::lock_guard lock{g_mutex};
+    for (auto& s : g_copySlots) {
+      if (s.state == SlotState::Available) {
+        slot = &s;
+        break;
+      }
+    }
+    if (slot == nullptr) {
+      Log.warn("No free copy read-back buffer: copy to {} dropped", req.dest);
+      return;
+    }
+    slot->state = SlotState::CopySubmitted;
+    slot->req = req;
+    slot->frameId = frameId;
+  }
+  // Reserve the slot first; resource allocation must not run under g_mutex.
+  if (!ensure_copy_slot(*slot, bytes)) {
+    std::lock_guard lock{g_mutex};
+    slot->state = SlotState::Available;
+    return;
+  }
+  const Params params{
+      .dstWidth = req.width,
+      .dstHeight = req.height,
+      .srcX = rect.x,
+      .srcY = rect.y,
+      .scaleX = float(rect.width) / float(req.width),
+      .scaleY = float(rect.height) / float(req.height),
+  };
+  g_queue.WriteBuffer(slot->params, 0, &params, sizeof(params));
+  const std::array bindEntries{
+      wgpu::BindGroupEntry{.binding = 0, .textureView = efbColor},
+      wgpu::BindGroupEntry{.binding = 1, .buffer = slot->storage, .size = bytes},
+      wgpu::BindGroupEntry{.binding = 2, .buffer = slot->params, .size = sizeof(Params)},
+  };
+  const wgpu::BindGroupDescriptor bgDesc{
+      .label = "SMS copy read-back",
+      .layout = g_copyLayout,
+      .entryCount = bindEntries.size(),
+      .entries = bindEntries.data(),
+  };
+  const auto bindGroup = g_device.CreateBindGroup(&bgDesc);
+  const wgpu::ComputePassDescriptor passDesc{.label = "SMS copy read-back"};
+  const auto pass = cmd.BeginComputePass(&passDesc);
+  pass.SetPipeline(g_copyPipeline);
+  pass.SetBindGroup(0, bindGroup);
+  pass.DispatchWorkgroups((req.width + 7) / 8, (req.height + 7) / 8);
+  pass.End();
+  cmd.CopyBufferToBuffer(slot->storage, 0, slot->readback, 0, bytes);
+}
+
+void after_submit() noexcept {
+  for (size_t i = 0; i < g_counterSlots.size(); ++i) {
+    uint64_t frameId = 0, generation = 0;
+    {
+      std::lock_guard lock{g_mutex};
+      auto& slot = g_counterSlots[i];
+      if (!g_active || slot.state != SlotState::CopySubmitted) continue;
+      slot.state = SlotState::MapPending;
+      frameId = slot.frameId;
+      generation = g_generation;
+    }
+    // AllowSpontaneous may invoke the callback synchronously from MapAsync,
+    // GetConstMappedRange, Unmap, or another Dawn call. No such call may hold
+    // g_mutex. Capture the buffer and request so shutdown cannot retire them
+    // before the callback has consumed/unmapped its own immutable request.
+    const auto buffer = g_counterSlots[i].buffer;
+    buffer.MapAsync(wgpu::MapMode::Read, 0, CounterBytes, wgpu::CallbackMode::AllowSpontaneous,
+                    [i, buffer, frameId, generation](wgpu::MapAsyncStatus status, wgpu::StringView) {
+                      std::vector<uint32_t> counts;
+                      if (status == wgpu::MapAsyncStatus::Success) {
+                        const auto* p = static_cast<const uint32_t*>(buffer.GetConstMappedRange(0, CounterBytes));
+                        if (p) counts.assign(p, p + AURORA_SMS_PIXEL_METRIC_SLOTS);
+                        buffer.Unmap();
+                      }
+                      std::lock_guard lock{g_mutex};
+                      if (!g_active || generation != g_generation) return;
+                      if (!counts.empty() && frameId >= g_latestCountsFrame) {
+                        g_latestCounts = std::move(counts);
+                        g_latestCountsFrame = frameId;
+                        g_latestCountsNew = true;
+                      }
+                      g_counterSlots[i].state = SlotState::Available;
+                    });
+  }
+  for (size_t i = 0; i < g_copySlots.size(); ++i) {
+    uint64_t frameId = 0, generation = 0;
+    CopyRequest req;
+    {
+      std::lock_guard lock{g_mutex};
+      auto& slot = g_copySlots[i];
+      if (!g_active || slot.state != SlotState::CopySubmitted) continue;
+      slot.state = SlotState::MapPending;
+      frameId = slot.frameId;
+      generation = g_generation;
+      req = slot.req;
+    }
+    const auto buffer = g_copySlots[i].readback;
+    const uint64_t bytes = uint64_t(req.width) * req.height * 4;
+    buffer.MapAsync(wgpu::MapMode::Read, 0, bytes, wgpu::CallbackMode::AllowSpontaneous,
+                    [i, buffer, bytes, req, frameId, generation](wgpu::MapAsyncStatus status, wgpu::StringView) {
+                      CopyResult result{.req = req, .frameId = frameId};
+                      if (status == wgpu::MapAsyncStatus::Success) {
+                        const auto* p = static_cast<const uint32_t*>(buffer.GetConstMappedRange(0, bytes));
+                        if (p) result.rgba.assign(p, p + bytes / 4);
+                        buffer.Unmap();
+                      }
+                      std::lock_guard lock{g_mutex};
+                      if (!g_active || generation != g_generation) return;
+                      if (!result.rgba.empty()) g_copyResults.push_back(std::move(result));
+                      g_copySlots[i].state = SlotState::Available;
+                    });
+  }
+}
+
+CopyRequest take_pending_copy() noexcept { return std::exchange(g_pendingCopy, {}); }
+
+} // namespace aurora::gfx::sms_readback
+
+using namespace aurora::gfx::sms_readback;
+
+extern "C" {
+uint64_t aurora_sms_current_frame_id(void) { return aurora::gfx::current_frame_id(); }
+
+float aurora_sms_efb_pixel_area_scale(void) {
+  // The same mapping as gx::map_logical_scissor: each axis scaled on its own.
+  if (aurora::gx::g_gxState.viewportPolicy == AURORA_VIEWPORT_NATIVE) {
+    return 1.f;
+  }
+  const auto [logicalWidth, logicalHeight] = aurora::gx::logical_fb_size();
+  const auto [targetWidth, targetHeight] = aurora::gfx::get_render_target_size();
+  if (logicalWidth == 0 || logicalHeight == 0 || targetWidth == 0 || targetHeight == 0) {
+    return 1.f;
+  }
+  return (float(targetWidth) / float(logicalWidth)) * (float(targetHeight) / float(logicalHeight));
+}
+
+int aurora_sms_poll_pixel_metrics(uint64_t* frameId, const uint32_t** counts) {
+  std::lock_guard lock{g_mutex};
+  if (!g_latestCountsNew) {
+    return 0;
+  }
+  g_latestCountsNew = false;
+  g_returnedCounts = g_latestCounts;
+  *frameId = g_latestCountsFrame;
+  *counts = g_returnedCounts.data();
+  return 1;
+}
+
+void aurora_sms_request_copy_readback(const void* dest, uint32_t width, uint32_t height) {
+  g_pendingCopy = CopyRequest{.dest = dest, .width = width, .height = height};
+}
+
+int aurora_sms_poll_copy_readback(const void** dest, uint32_t* width, uint32_t* height, uint64_t* frameId,
+                                  const uint32_t** rgba) {
+  std::lock_guard lock{g_mutex};
+  if (g_copyResults.empty()) {
+    return 0;
+  }
+  g_returnedCopy = std::move(g_copyResults.front());
+  g_copyResults.pop_front();
+  *dest = g_returnedCopy.req.dest;
+  *width = g_returnedCopy.req.width;
+  *height = g_returnedCopy.req.height;
+  *frameId = g_returnedCopy.frameId;
+  *rgba = g_returnedCopy.rgba.data();
+  return 1;
+}
+}

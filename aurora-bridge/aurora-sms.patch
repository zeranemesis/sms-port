 lib/gfx/common.hpp            |  6 ++--
 lib/gx/command_processor.cpp  | 11 ++++---
 lib/gx/shader.cpp             | 54 +++++++++++++++++++++++++++++------
 lib/gx/shader_info.cpp        | 18 +++++++++---
 5 files changed, 74 insertions(+), 22 deletions(-)


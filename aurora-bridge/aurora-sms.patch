From 028e692aa83d5fb2507619b1e3ad35709104e62d Mon Sep 17 00:00:00 2001
From: Valentin SAMSON <BEAVSN@BEA.local>
Date: Sun, 18 Oct 2026 09:11:53 +0200
Subject: [PATCH 4/5] GX: drop GX_CULL_ALL polygons instead of aborting

Super Mario Eclipse sets GX_CULL_ALL, which the GameCube honours by
culling every polygon (lines and points are never culled). WebGPU has no
such mode: the command processor now skips those draws, and a pipeline
asking for it (from an older pipeline cache) gets no culling.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 lib/gx/command_processor.cpp | 8 ++++++++
 lib/gx/gx.cpp                | 3 +++
 2 files changed, 11 insertions(+)

diff --git a/lib/gx/command_processor.cpp b/lib/gx/command_processor.cpp
index d3d399b..9aa6658 100644
--- a/lib/gx/command_processor.cpp
+++ b/lib/gx/command_processor.cpp
@@ -1558,6 +1558,14 @@ static void draw_prim(GXPrimitive prim, GXVtxFmt fmt, u16 vtxCount, const u8* da
   if (pos + totalVtxBytes > size)
     UNLIKELY { handle_draw_overrun(totalVtxBytes, data, pos, size); }
 
+  // GX_CULL_ALL culls every polygon (lines and points are never culled);
+  // WebGPU has no such mode, so the draw is dropped here.
+  if (g_gxState.cullMode == GX_CULL_ALL && prim != GX_LINES && prim != GX_LINESTRIP && prim != GX_POINTS)
+    UNLIKELY {
+      pos += totalVtxBytes;
+      return;
+    }
+
   auto* lastDraw = !g_gxState.stateDirty ? gfx::get_last_draw_command<DrawData>() : nullptr;
   const bool canMerge = lastDraw != nullptr && prim != GX_LINES && prim != GX_LINESTRIP && prim != GX_POINTS &&
                         lastDraw->instanceCount == 1;

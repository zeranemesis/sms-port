@@ -0,0 +1,43 @@
+#ifndef AURORA_SMS_EXT_H
+#define AURORA_SMS_EXT_H
+
+/*
+ * Extensions for the Super Mario Sunshine PC port (sms_aurora.dll):
+ * - pixel metrics: a GX_LOAD_AURORA_PIXEL_METRIC command (see GXAurora.h) makes the
+ *   following draws count the fragments that pass the alpha test into a counter slot;
+ *   the counts of each frame are read back asynchronously;
+ * - EFB copy read-back: the next GXCopyTex is also read back to the CPU as RGBA8 at
+ *   the size the game asked for, so the game's own copy of the texture can be updated.
+ */
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define AURORA_SMS_PIXEL_METRIC_SLOTS 256
+
+/* The id of the frame being recorded (0 outside a frame). */
+uint64_t aurora_sms_current_frame_id(void);
+
+/* The EFB pixels per logical (GX) pixel, for scaling counts back to GX pixels. */
+float aurora_sms_efb_pixel_area_scale(void);
+
+/* Returns 1 and the counts of the newest frame whose counters were read back since
+ * the last call; counts holds AURORA_SMS_PIXEL_METRIC_SLOTS values, valid until the
+ * next call. */
+int aurora_sms_poll_pixel_metrics(uint64_t* frameId, const uint32_t** counts);
+
+/* The next GXCopyTex is read back too (width x height RGBA8 texels). */
+void aurora_sms_request_copy_readback(const void* dest, uint32_t width, uint32_t height);
+
+/* Returns 1 and one finished read-back (rgba valid until the next call). */
+int aurora_sms_poll_copy_readback(const void** dest, uint32_t* width, uint32_t* height, uint64_t* frameId,
+                                  const uint32_t** rgba);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif

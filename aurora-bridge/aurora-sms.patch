+// Sunshine's presentation controls apply before the UI is composed. This
+// single-frame FXAA pass has no history buffer and cannot leave trails.
+constexpr std::string_view sunshinePresentFragmentSource = R"(
+struct PresentUniforms { parameters: vec4<f32>, };
+@group(0) @binding(1) var s: sampler;
+@group(1) @binding(0) var t: texture_2d<f32>;
+@group(2) @binding(0) var<uniform> settings: PresentUniforms;
+fn sample_color(uv: vec2<f32>) -> vec3<f32> {
+    return textureSampleLevel(t, s, uv, 0.0).rgb;
+}
+@fragment
+fn main(@location(0) uv: vec2<f32>) -> @location(0) vec4<f32> {
+    let center = textureSampleLevel(t, s, uv, 0.0);
+    var rgb = center.rgb;
+    if (settings.parameters.y > 0.5) {
+        let pixel = settings.parameters.zw;
+        let weight = vec3<f32>(0.299, 0.587, 0.114);
+        let nw = dot(sample_color(uv + vec2<f32>(-1.0,-1.0)*pixel), weight);
+        let ne = dot(sample_color(uv + vec2<f32>( 1.0,-1.0)*pixel), weight);
+        let sw = dot(sample_color(uv + vec2<f32>(-1.0, 1.0)*pixel), weight);
+        let se = dot(sample_color(uv + vec2<f32>( 1.0, 1.0)*pixel), weight);
+        let middle = dot(center.rgb, weight);
+        let low = min(middle,min(min(nw,ne),min(sw,se)));
+        let high = max(middle,max(max(nw,ne),max(sw,se)));
+        var direction = vec2<f32>(-(nw+ne-sw-se),nw+sw-ne-se);
+        let reduce = max((nw+ne+sw+se)*0.03125,0.0078125);
+        let reciprocal = 1.0/(min(abs(direction.x),abs(direction.y))+reduce);
+        direction = clamp(direction*reciprocal,vec2<f32>(-8.0),vec2<f32>(8.0))*pixel;
+        let a = 0.5*(sample_color(uv+direction*(-1.0/6.0))+sample_color(uv+direction*(1.0/6.0)));
+        let b = a*0.5+0.25*(sample_color(uv-direction*0.5)+sample_color(uv+direction*0.5));
+        let luminance = dot(b,weight);
+        rgb = select(b,a,luminance<low || luminance>high);
+    }
+    rgb = pow(clamp(rgb,vec3<f32>(0.0),vec3<f32>(1.0)),vec3<f32>(settings.parameters.x));
+    return vec4<f32>(rgb,center.a);
+}

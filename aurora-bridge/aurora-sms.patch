index b828fec..69b568d 100644
--- a/lib/gx/gx.cpp
+++ b/lib/gx/gx.cpp
@@ -620,6 +620,9 @@ static inline wgpu::PrimitiveState to_primitive_state(GXCullMode gx_cullMode) {

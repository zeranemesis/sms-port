 static AuroraSampler g_Resampler = SAMPLER_BILINEAR;
 static int g_presentMode = 0;
 static bool g_adaptiveVsync = false;
+static bool g_preferMailbox = false;
 static uint32_t g_integerWidth = 640, g_integerHeight = 480;
 static wgpu::BindGroupLayout g_ResampleBindGroupLayout;
 static wgpu::RenderPipeline g_ResamplePipeline;
@@ -179,6 +180,9 @@ wgpu::PresentMode best_present_mode(bool vsync) {
     return false;
   };
   if (vsync) {
+    if (g_preferMailbox && g_backendType != wgpu::BackendType::Metal && supports(wgpu::PresentMode::Mailbox)) {
+      return wgpu::PresentMode::Mailbox;
+    }
     if (g_adaptiveVsync && supports(wgpu::PresentMode::FifoRelaxed)) {
       return wgpu::PresentMode::FifoRelaxed;
     }
@@ -296,6 +300,7 @@ const TextureWithSampler& present_source() noexcept {
 }
 

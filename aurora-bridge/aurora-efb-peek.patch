+bool peek_efb(uint32_t x, uint32_t y, uint64_t revision, uint32_t& argb, uint32_t& z) {
+  if (!g_recordingFrame || g_currentRenderPass==UINT32_MAX || g_inOffscreen) return false;
+  const auto logicalSize=gx::logical_fb_size();
+  if (x>=logicalSize.x || y>=logicalSize.y) return false;
+  static uint64_t cachedFrame=0, cachedRevision=0;
+  auto& frame=current_frame_packet();
+  if (cachedFrame!=frame.frameId || cachedRevision!=revision) {
+    // Seal exactly the draws preceding GXPeek, before later HUD/pollution clears.
+    frame.uniforms.append_zeroes(gx::MaxUniformSize);
+    auto& oldPass=frame.renderPasses[g_currentRenderPass];
+    oldPass.observable=true;
+    const auto color=oldPass.colorView, depth=oldPass.copySourceDepthView;
+    const auto size=oldPass.targetSize;
+    const auto samples=oldPass.msaaSamples;
+    enqueue_pass(frame,g_recordingFrameSlot,g_currentRenderPass);
+    // Staging storage must be unmapped for submission. Preserve its populated
+    // ranges and restore them after remapping so all existing offsets stay valid.
+    std::array saved{frame.verts.clone(),frame.uniforms.clone(),frame.indices.clone(),
+                     frame.storage.clone(),frame.textureUpload.clone()};
+    const auto frameSlot=g_recordingFrameSlot;
+    render_worker::enqueue_work([frameSlot,color,depth,size,logicalSize,samples] {
+      auto& packet=g_framePackets[frameSlot];
+      efb_peek::encode(packet.encoder,color,depth,size,logicalSize,samples);
+      const auto staging=packet.stagingBuffer;
+      g_stagingBuffers[staging].Unmap();
+      s_mappingStates[staging].store(BufferMapState::Unmapped,std::memory_order_release);
+      const auto commands=packet.encoder.Finish();
+      g_queue.Submit(1,&commands);
+      efb_peek::complete();
+      auto mapped=std::make_shared<bool>(false);
+      const auto future=g_stagingBuffers[staging].MapAsync(wgpu::MapMode::Write,0,StagingBufferSize,
+          wgpu::CallbackMode::WaitAnyOnly,[mapped](wgpu::MapAsyncStatus status,wgpu::StringView) {
+            *mapped=status==wgpu::MapAsyncStatus::Success;
+          });
+      const auto result=g_instance.WaitAny(future,5'000'000'000);
+      CHECK(result==wgpu::WaitStatus::Success && *mapped,"EFB peek staging remap failed or timed out");
+      s_mappingStates[staging].store(BufferMapState::Mapped,std::memory_order_release);
+      const wgpu::CommandEncoderDescriptor desc{.label="Continue after EFB peek"};
+      packet.encoder=g_device.CreateCommandEncoder(&desc);
+    });
+    render_worker::synchronize();
+    const auto& staging=g_stagingBuffers[frame.stagingBuffer];
+    std::array<ByteBuffer*,5> buffers{&frame.verts,&frame.uniforms,&frame.indices,&frame.storage,&frame.textureUpload};
+    constexpr std::array capacities{VertexBufferSize,UniformBufferSize,IndexBufferSize,StorageBufferSize,TextureUploadSize};
+    uint64_t offset=0;
+    for (size_t i=0;i<buffers.size();++i) {
+      *buffers[i]=ByteBuffer{static_cast<uint8_t*>(staging.GetMappedRange(offset,capacities[i])),size_t(capacities[i])};
+      if (!saved[i].empty()) buffers[i]->append(saved[i].data(),saved[i].size());
+      offset+=capacities[i];
+    }
+    RenderPass next;
+    set_efb_targets(next);
+    next.clearColor=false; next.clearDepth=false;
+    next.commands.reserve(2048);
+    frame.renderPasses.emplace_back(std::move(next));
+    g_currentRenderPass=static_cast<uint32_t>(frame.renderPasses.size()-1);
+    push_command(CommandType::SetViewport,Command::Data{.setViewport=g_cachedViewport});
+    push_command(CommandType::SetScissor,Command::Data{.setScissor=g_cachedScissor});
+    cachedFrame=frame.frameId; cachedRevision=revision;
+  }
+  if (!efb_peek::read(x,y,argb,z)) return false;
+  if (gx::g_gxState.pixelFmt!=GX_PF_RGBA6_Z24) argb|=0xff000000u;
+  return true;
+}

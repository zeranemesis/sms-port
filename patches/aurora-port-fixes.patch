diff --git a/lib/webgpu/gpu.cpp b/lib/webgpu/gpu.cpp
index a969465..6f5e446 100644
--- a/lib/webgpu/gpu.cpp
+++ b/lib/webgpu/gpu.cpp
@@ -177,13 +177,15 @@ wgpu::PresentMode best_present_mode(bool vsync) {
       return wgpu::PresentMode::FifoRelaxed;
     }
   } else {
-    // Dawn only disables CAMetalLayer displaySyncEnabled for Immediate on Metal
-    if (g_backendType != wgpu::BackendType::Metal && supports(wgpu::PresentMode::Mailbox)) {
-      return wgpu::PresentMode::Mailbox;
-    }
+    // Mailbox still waits for the display refresh and therefore caps unlocked
+    // rendering to the monitor's rate. Prefer Immediate when VSync is disabled
+    // so user-selected targets such as 240 FPS are actually reachable.
     if (supports(wgpu::PresentMode::Immediate)) {
       return wgpu::PresentMode::Immediate;
     }
+    if (supports(wgpu::PresentMode::Mailbox)) {
+      return wgpu::PresentMode::Mailbox;
+    }
   }
   return wgpu::PresentMode::Fifo;
 }
diff --git a/lib/window.cpp b/lib/window.cpp
index 0d1a5c2..1d80f01 100644
--- a/lib/window.cpp
+++ b/lib/window.cpp
@@ -359,6 +359,19 @@ void show_window() {

 bool initialize() {
   /* We don't want to initialize anything input related here, otherwise the add events will get lost to the void */
+  // The official Nintendo adapter (WUP-028, VID 057E / PID 0337) needs
+  // SDL's HIDAPI GameCube driver and its libusb transport on Windows.  Keep
+  // these explicit instead of relying on SDL defaults so a system-wide SDL
+  // environment variable cannot silently fall back to a generic joystick
+  // mapping (which loses the analogue triggers, C-stick and adapter rumble).
+  TRY(SDL_SetHintWithPriority(SDL_HINT_HIDAPI_LIBUSB, "1", SDL_HINT_OVERRIDE), "Error setting {}: {}",
+      SDL_HINT_HIDAPI_LIBUSB, SDL_GetError());
+  TRY(SDL_SetHintWithPriority(SDL_HINT_HIDAPI_LIBUSB_GAMECUBE, "1", SDL_HINT_OVERRIDE), "Error setting {}: {}",
+      SDL_HINT_HIDAPI_LIBUSB_GAMECUBE, SDL_GetError());
+  TRY(SDL_SetHintWithPriority(SDL_HINT_JOYSTICK_HIDAPI, "1", SDL_HINT_OVERRIDE), "Error setting {}: {}",
+      SDL_HINT_JOYSTICK_HIDAPI, SDL_GetError());
+  TRY(SDL_SetHintWithPriority(SDL_HINT_JOYSTICK_HIDAPI_GAMECUBE, "1", SDL_HINT_OVERRIDE), "Error setting {}: {}",
+      SDL_HINT_JOYSTICK_HIDAPI_GAMECUBE, SDL_GetError());
   TRY(SDL_SetHint(SDL_HINT_ORIENTATIONS, "LandscapeLeft LandscapeRight"), "Error setting {}: {}", SDL_HINT_ORIENTATIONS,
       SDL_GetError());
   TRY(SDL_InitSubSystem(SDL_INIT_EVENTS | SDL_INIT_VIDEO), "Error initializing SDL: {}", SDL_GetError());

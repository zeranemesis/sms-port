+void report_draw_fate() {
+  static auto lastReport = std::chrono::steady_clock::now();
+  static unsigned reports = 0;
+  static u64 lastSubmitted = 0;
+  static u64 lastReached = 0;
+  static u64 lastNotReady = 0;
+  static u64 lastIssued = 0;
+  static u64 lastNoTexture = 0;
+
+  const auto now = std::chrono::steady_clock::now();
+  if (now - lastReport < std::chrono::seconds(1) || reports >= 600) {
+    return;
+  }
+  lastReport = now;
+  ++reports;
+
+  const u64 submitted = g_submitted - lastSubmitted;
+  const u64 reached = g_reachedRender - lastReached;
+  const u64 notReady = g_pipelineNotReady - lastNotReady;
+  const u64 issued = g_issued - lastIssued;
+  const u64 noTexture = g_issuedWithoutTexture - lastNoTexture;
+  lastSubmitted = g_submitted;
+  lastReached = g_reachedRender;
+  lastNotReady = g_pipelineNotReady;
+  lastIssued = g_issued;
+  lastNoTexture = g_issuedWithoutTexture;
+
+  // The probe checks its own arithmetic. Every draw that reaches render()
+  // either loses its pipeline or is issued, so those two must add up - and if
+  // they ever do not, the counter is lying and says so rather than being
+  // believed. Six probes in this port have already produced a false reading by
+  // being coarser than their subject.
+  // Check the CUMULATIVE totals, not the per-second deltas. A draw submitted
+  // in one frame is rendered in the next, so a delta window can legitimately
+  // straddle that boundary and show reached slightly above or below submitted -
+  // which made the check cry wolf on its first run. The invariant that really
+  // holds is that every draw reaching render() either loses its pipeline or is
+  // issued, and that is exact over the totals.
+  const bool consistent = g_pipelineNotReady + g_issued == g_reachedRender;
+  Log.info("draw fate 1s: submitted={} reached_render={} (dropped_before_render={}) | pipeline_not_ready={} "
+           "issued={} of which without_texture={}{}",
+           submitted, reached, submitted >= reached ? submitted - reached : 0, notReady, issued, noTexture,
+           consistent ? "" : "  <-- COUNTER INCONSISTENT, do not trust this line");
+}

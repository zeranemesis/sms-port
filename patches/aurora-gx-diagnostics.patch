diff --git a/lib/gx/command_processor.cpp b/lib/gx/command_processor.cpp
index 9748556..ff74401 100644
--- a/lib/gx/command_processor.cpp
+++ b/lib/gx/command_processor.cpp
@@ -566,6 +566,19 @@ static void handle_bp(u32 value, bool bigEndian) {
   switch (regId) {
   // genMode (0x00)
   case 0x00: {
+    // genMode is the register a zeroed guest GX shadow would land on, and it
+    // carries numTexGens - trace every distinct value, capped, so a clobber is
+    // visible with its ordering relative to the XF texgen writes.
+    {
+      static u32 lastGenMode = 0xFFFFFFFFu;
+      static u32 genModeLogged = 0;
+      if (value != lastGenMode && genModeLogged < 32) {
+        lastGenMode = value;
+        ++genModeLogged;
+        Log.info("genMode = 0x{:08X} (numTexGens={} numChans={} numTevStages={})", value, bp_get(value, 4, 0),
+                 bp_get(value, 3, 4), bp_get(value, 4, 10) + 1);
+      }
+    }
     g_gxState.numTexGens = bp_get(value, 4, 0);
     g_gxState.numChans = bp_get(value, 3, 4);
     g_gxState.numTevStages = bp_get(value, 4, 10) + 1;
@@ -1282,6 +1295,17 @@ static void handle_xf(const u8* data, u32& pos, u32 size, bool bigEndian) {
       u32 reg = xfAddr + i;
       u32 val = read_u32(xfData + i * 4, bigEndian);
 
+      // Trace each XF register the first time it is ever written, so a missing
+      // texgen/numTexGens setup is visible as an absence rather than guessed at.
+      // One line per register, so this cannot run away.
+      {
+        static std::array<bool, 0x100> seenXfReg{};
+        if (reg < seenXfReg.size() && !seenXfReg[reg]) {
+          seenXfReg[reg] = true;
+          Log.info("first XF write: reg 0x{:02X} = 0x{:08X}", reg, val);
+        }
+      }
+
       // Skip scalar register writes that haven't changed (viewport/projection handled below)
       if (reg <= 0x19 && val == g_gxState.xfRegCache[reg])
         continue;
@@ -1608,6 +1632,23 @@ static void handle_draw(u8 cmd, const u8* data, u32& pos, u32 size, bool bigEndi
   u16 vtxCount = read_u16(data + pos, bigEndian);
   pos += 2;
 
+  // "The screen is one flat colour" is equally consistent with the game not
+  // having drawn anything yet and with it drawing into nowhere. This counts
+  // what actually arrives, periodically and capped, so the two can be told
+  // apart instead of guessed at.
+  {
+    static u64 draws = 0;
+    static u64 vertices = 0;
+    static unsigned reported = 0;
+    ++draws;
+    vertices += vtxCount;
+    if ((draws % 20000ull) == 1ull && reported < 20) {
+      ++reported;
+      Log.info("draw #{}: prim={:#04x} fmt={} vtxCount={} (total vertices {})", draws, static_cast<u32>(prim),
+               static_cast<u32>(fmt), vtxCount, vertices);
+    }
+  }
+
   draw_prim(prim, fmt, vtxCount, data, pos, size);
 }
 

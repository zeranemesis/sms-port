@@ -1608,6 +1635,79 @@ static void handle_draw(u8 cmd, const u8* data, u32& pos, u32 size, bool bigEndi
   u16 vtxCount = read_u16(data + pos, bigEndian);
   pos += 2;
 
+  // "The screen is one flat colour" is equally consistent with the game not
+  // having drawn anything yet and with it drawing into nowhere. This counts
+  // what actually arrives so the two can be told apart instead of guessed at.
+  //
+  // The gate is wall-clock, NOT every-Nth-draw. A 1-in-20000 gate was tried
+  // first and produced a measurement that read as "one draw in 90 seconds",
+  // which was simply wrong: 11,730 frames x 1 quad = 11,730 draws, under the
+  // threshold, so the second report never came. Anything rate-limited by its
+  // own subject cannot distinguish "rare" from "just below the threshold".
+  //
+  // What the shape of the output means, against src/System/Application.cpp:
+  //   GX_QUADS (0x80) / 4 verts, once per frame  -> only TSMSFader::draw is
+  //     running, i.e. APP_STATE_BOOT with no director created.
+  //   GX_TRIANGLES (0x90) / 6 verts, once per frame -> drawDVDErr() is
+  //     returning non-zero every frame (Application.cpp:609), which skips both
+  //     the state machine and all director rendering.
+  {
+    static u64 draws = 0;
+    static u64 vertices = 0;
+    static u64 drawsReported = 0;
+    static u64 verticesReported = 0;
+    static unsigned reports = 0;
+    static auto lastReport = std::chrono::steady_clock::now();
+
+    // Per-interval tally of the distinct {primitive, vertex count} pairs seen.
+    // Fixed size: first eight distinct kinds win and the rest are counted as
+    // overflow, so a pathological frame cannot grow this.
+    struct Kind {
+      u32 prim;
+      u16 vtxCount;
+      u32 count;
+    };
+    static std::array<Kind, 8> kinds{};
+    static u32 kindsUsed = 0;
+    static u32 kindOverflow = 0;
+
+    ++draws;
+    vertices += vtxCount;
+
+    bool counted = false;
+    for (u32 i = 0; i < kindsUsed; ++i) {
+      if (kinds[i].prim == static_cast<u32>(prim) && kinds[i].vtxCount == vtxCount) {
+        ++kinds[i].count;
+        counted = true;
+        break;
+      }
+    }
+    if (!counted) {
+      if (kindsUsed < kinds.size()) {
+        kinds[kindsUsed++] = {static_cast<u32>(prim), vtxCount, 1};
+      } else {
+        ++kindOverflow;
+      }
+    }
+
+    const auto now = std::chrono::steady_clock::now();
+    if (reports < 120 && now - lastReport >= std::chrono::seconds(1)) {
+      lastReport = now;
+      ++reports;
+      std::string breakdown;
+      for (u32 i = 0; i < kindsUsed; ++i) {
+        breakdown += fmt::format("{}{:#04x}/{} x{}", i == 0 ? "" : " ", kinds[i].prim, kinds[i].vtxCount,
+                                 kinds[i].count);
+      }
+      Log.info("draw 1s: total={} (+{}) verts={} (+{}) prims=[{}] overflow={}", draws, draws - drawsReported, vertices,
+               vertices - verticesReported, breakdown, kindOverflow);
+      drawsReported = draws;
+      verticesReported = vertices;
+      kindsUsed = 0;
+      kindOverflow = 0;
+    }
+  }
+
   draw_prim(prim, fmt, vtxCount, data, pos, size);
 }
 

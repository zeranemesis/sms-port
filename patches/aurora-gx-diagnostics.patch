@@ -566,6 +569,19 @@ static void handle_bp(u32 value, bool bigEndian) {
   switch (regId) {
   // genMode (0x00)
   case 0x00: {
+    // genMode is the register a zeroed guest GX shadow would land on, and it
+    // carries numTexGens - trace every distinct value, capped, so a clobber is
+    // visible with its ordering relative to the XF texgen writes.
+    {
+      static u32 lastGenMode = 0xFFFFFFFFu;
+      static u32 genModeLogged = 0;
+      if (value != lastGenMode && genModeLogged < 32) {
+        lastGenMode = value;
+        ++genModeLogged;
+        Log.info("genMode = 0x{:08X} (numTexGens={} numChans={} numTevStages={})", value, bp_get(value, 4, 0),
+                 bp_get(value, 3, 4), bp_get(value, 4, 10) + 1);
+      }
+    }
     g_gxState.numTexGens = bp_get(value, 4, 0);
     g_gxState.numChans = bp_get(value, 3, 4);
     g_gxState.numTevStages = bp_get(value, 4, 10) + 1;
@@ -1282,6 +1298,17 @@ static void handle_xf(const u8* data, u32& pos, u32 size, bool bigEndian) {
       u32 reg = xfAddr + i;
       u32 val = read_u32(xfData + i * 4, bigEndian);
 
+      // Trace each XF register the first time it is ever written, so a missing
+      // texgen/numTexGens setup is visible as an absence rather than guessed at.
+      // One line per register, so this cannot run away.
+      {
+        static std::array<bool, 0x100> seenXfReg{};
+        if (reg < seenXfReg.size() && !seenXfReg[reg]) {

+static void call_display_list(u32 listAddress, u32 listBytes, bool bigEndian);
+
+// Executes a display list in place, the way the GP does.
+//
+// A display list lives in guest RAM and is complete by construction, so it is
+// processed OUTSIDE stream mode: it can never be "cut" the way the write-gather
+// FIFO can, and letting a truncation inside it set the stream flags would make
+// the outer FIFO believe it had been cut and carry over bytes that were never
+// its own. The flags are therefore saved and restored around the call.
+//
+// Depth is bounded because the hardware allows one level of nesting and a
+// corrupt pointer could otherwise recurse until the stack runs out. A list that
+// nests deeper is refused and reported rather than followed.
+static void call_display_list(u32 listAddress, u32 listBytes, bool bigEndian) {
+  static u32 s_displayListDepth = 0;
+  constexpr u32 kMaxDisplayListDepth = 2;
+
+  if (listBytes == 0) {
+    return;
+  }
+  if (s_displayListDepth >= kMaxDisplayListDepth) {
+    static bool warnedDepth = false;
+    if (!warnedDepth) {
+      warnedDepth = true;
+      Log.error("display list nested deeper than {} - refusing to follow it", kMaxDisplayListDepth);
+    }
+    return;
+  }
+
+  u32 readable = 0;
+  void* host = g_guestMemoryResolver != nullptr ? g_guestMemoryResolver(listAddress, &readable) : nullptr;
+  if (host == nullptr || readable < listBytes) {
+    // Bounded per address: this runs at thousands of lists per second, and an
+    // unbounded version of the line it replaces produced 512,094 entries in 70
+    // seconds.
+    static std::unordered_set<u32> warnedLists;
+    if (warnedLists.size() < 32 && warnedLists.insert(listAddress).second) {
+      Log.error("display list at {:#010x} ({} bytes) could not be resolved to host memory", listAddress, listBytes);
+    }
+    return;
+  }
+
+  const bool savedStreamMode = s_streamMode;
+  const bool savedTruncated = s_streamTruncated;
+  const u32 savedCmdStart = s_streamCmdStart;
+  s_streamMode = false;
+  s_streamTruncated = false;
+
+  ++s_displayListDepth;
+  process(static_cast<const u8*>(host), listBytes, bigEndian);
+  --s_displayListDepth;
+
+  s_streamMode = savedStreamMode;
+  s_streamTruncated = savedTruncated;
+  s_streamCmdStart = savedCmdStart;

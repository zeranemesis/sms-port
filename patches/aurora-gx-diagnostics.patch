+        const auto s16at = [&](u32 o) { return static_cast<s16>((u32(p[o]) << 8) | p[o + 1]); };
+        const auto u16at = [&](u32 o) { return static_cast<u16>((u32(p[o]) << 8) | p[o + 1]); };
+        Log.info("THP quad v{}: pos=({}, {}, {}) st=({}, {})", v, s16at(0), s16at(2), s16at(4), u16at(6), u16at(8));
+      }
+      Log.info("THP quad: renderViewport {}x{} logicalViewport {}x{} projType {}", g_gxState.renderViewport.width,
+               g_gxState.renderViewport.height, g_gxState.logicalViewport.width, g_gxState.logicalViewport.height,
+               static_cast<u32>(g_gxState.projType));
+    }
+  }
+
   draw_prim(prim, fmt, vtxCount, data, pos, size);
 }
 

+// Stream mode: the host frame boundary can cut this FIFO between a command's
+// opcode and its payload, because the guest is stepped for a fixed budget of
+// translated blocks and that budget expires at an arbitrary instruction.  Real
+// hardware never sees this - the GP reads a stream and simply waits for the
+// rest - so aborting on a short tail turns a normal cut into a fatal error.
+//
+// Measured twice: "draw vertex data overrun: need 80 bytes at pos N, have N",
+// at two completely different FIFO positions but with byte-identical preceding
+// commands (LOAD_CP_REG VAT_B0, LOAD_CP_REG VAT_C0, then draw quads x4).  The
+// buffer ended exactly on the draw header, which is a cut, not corruption.
+//
+// In stream mode a truncated command stops processing at that command's first
+// byte and reports the position, so drain() can carry the tail into the next
+// buffer.  Outside stream mode - display lists, which are complete by
+// construction - every CHECK below still fires exactly as before.
+// The last commands parsed, so a desync can say what led to it. The byte the
+// parser chokes on is never the byte that went wrong - it is wherever the
+// previous command's length was mis-computed and left the cursor stranded.
+struct ParsedCommand {
+  u32 pos;
+  u8 opcode;
+  u32 consumed;
+};
+static std::array<ParsedCommand, 12> s_recentCommands {};
+static size_t s_recentNext = 0;
+
+static void note_command(u32 pos, u8 opcode, u32 consumed) {
+  s_recentCommands[s_recentNext] = ParsedCommand{pos, opcode, consumed};
+  s_recentNext = (s_recentNext + 1) % s_recentCommands.size();
+}
+
+static void dump_recent_commands() {
+  std::string trail;
+  for (size_t i = 0; i < s_recentCommands.size(); ++i) {
+    const auto& c = s_recentCommands[(s_recentNext + i) % s_recentCommands.size()];
+    if (c.consumed == 0 && c.opcode == 0 && c.pos == 0) {
+      continue;
+    }
+    trail += fmt::format(" [pos {} op {:02x} +{}]", c.pos, c.opcode, c.consumed);
+  }
+  Log.error("  commands leading here:{}", trail);
+}
+
+// Installed by the host so guest physical addresses - in the CP array-base
+// registers and in GX_CMD_CALL_DL - can be turned into something Aurora can
+// actually read.
+GuestMemoryResolver g_guestMemoryResolver = nullptr;
+
+static bool s_streamMode = false;
+static bool s_streamTruncated = false;
+static u32 s_streamCmdStart = 0;
+
+static bool fifo_truncated(u32 pos, u32 need, u32 size) {
+  if (static_cast<u64>(pos) + need <= size) {
+    return false;
+  }
+  if (!s_streamMode) {
+    return false; // let the caller's CHECK report it, as before
+  }
+  s_streamTruncated = true;
+  return true;
+}
